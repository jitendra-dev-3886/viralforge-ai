# Do not put real API keys in this file. Copy it to backend/.env and add keys.
# Free Groq model with a higher daily token limit than llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.1-8b-instant

# Live niche-trend providers (optional; niche ideas are used as a fallback).
YOUTUBE_API_KEY=
NEWS_API_KEY=

# Stock media providers used by generated scene previews.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: a fully local, no-per-request-cost fallback through Ollama.
# Ollama exposes an OpenAI-compatible endpoint that the existing LocalAI client uses.
LOCALAI_URL=http://localhost:11434
LOCALAI_MODEL=qwen3:8b
